  "metrics_schema": {
    "version": 1,
    "sample_limit_per_metric": 512,
    "percentiles": "Linear interpolation over retained samples; n=0 yields null, not zero.",
    "clock": "Qt/controller use parent perf_counter. FrameHandle receipt uses the same OS counter (Microview native QPC). Worker timings use same-process durations only, with no cross-process timestamp subtraction.",
    "frame_scope": "Most recent admitted source/generation and capture run; retained after stop, reset at next run. Analysis metrics span this workspace lifetime.",
    "fps": "P50/P95 use instantaneous inverse intervals; frame_sampling.window_fps uses (retained_frames-1)/elapsed_span. Neither is camera sensor FPS.",
    "limitations": [
      "No sensor exposure timestamp",
      "No isolated Qt paint CPU measurement",
      "Child startup and IPC overhead are combined, not individually measured",
      "Synthetic and real-device runs require separate baseline comparison"
    ],
    "metrics": {
      "analysis_ms": {
        "unit": "ms",
        "definition": "Controller submission to result consumption; includes scheduling, process startup, shared memory, service, IPC and Qt polling."
      },
      "alignment_ms": {
        "unit": "ms",
        "definition": "Independent fixed-reference alignment function wall time; excludes executor queue wait."
      },
      "candidate_verification_ready_ms": {
        "unit": "ms",
        "definition": "Alignment submission to parent worker result readiness; includes serial queue, process/IPC and algorithm, excludes Qt consumption."
      },
      "candidate_verification_gui_wait_ms": {
        "unit": "ms",
        "definition": "Parent result readiness to GUI consumption, separately measured from verification work."
      },
      "candidate_verification_delivery_ms": {
        "unit": "ms",
        "definition": "Alignment submission to GUI consumption, including executor and Qt scheduling; measured for the actual checked frame."
      },
      "candidate_available_ms": {
        "unit": "ms",
        "definition": "Completed continuous candidate presentation interval before a latched pause; excludes unfinished intervals."
      },
      "candidate_unavailable_ms": {
        "unit": "ms",
        "definition": "Completed latched candidate pause until sustained timely recovery; live image presentation continues."
      },
      "click_to_accept_ms": {
        "unit": "ms",
        "definition": "Candidate intent creation to ledger insertion; includes queued clicks and motion/alignment verification, excludes subsequent UI painting."
      },
      "stable_wait_ms": {
        "unit": "ms",
        "definition": "Additional automatic-analysis stable interval after global readiness and first successful independent alignment; excludes earlier field settling."
      },
      "analysis_to_paint_ms": {
        "unit": "ms",
        "definition": "Controller submission to first paint containing candidates; includes analysis and presentation delay, not isolated paint CPU time."
      },
      "ingest_fps": {
        "unit": "frames/s",
        "definition": "Reciprocal intervals between distinct live frames admitted by the controller, using parent perf_counter; upstream mailbox drops are not counted."
      },
      "presented_fps": {
        "unit": "frames/s",
        "definition": "Reciprocal intervals between distinct live frames completing Qt paint; repeated paints of one frame are excluded."
      },
      "frame_age_ms": {
        "unit": "ms",
        "definition": "First completed Qt paint minus FrameHandle.received_at on the OS performance-counter timeline. Microview uses SDK callback buffer-copy completion (QPC); other adapters use application receipt. NOT sensor exposure age."
      },
      "analysis_service_total_ms": {
        "unit": "ms",
        "definition": "Child analyze_frame total wall time, including input preparation and native analysis."
      },
      "analysis_preparation_ms": {
        "unit": "ms",
        "definition": "Child analyze_frame input validation/native loading/pixel preparation before native invocation."
      },
      "analysis_processing_ms": {
        "unit": "ms",
        "definition": "Service total minus preparation; native invocation and result wrapping, not an isolated native kernel benchmark."
      },
      "analysis_shared_memory_ms": {
        "unit": "ms",
        "definition": "Parent shared-memory allocation and source-pixel copy."
      },
      "analysis_budget_wait_ms": {
        "unit": "ms",
        "definition": "Parent wait for the shared heavy-compute permit after pixel copy; excludes process startup."
      },
      "analysis_process_start_call_ms": {
        "unit": "ms",
        "definition": "Cold starts only: parent Pipe/Event/process.start call. Does not include all child imports or readiness."
      },
      "analysis_dispatch_to_receive_ms": {
        "unit": "ms",
        "definition": "Parent command-send start to reader recv completion/deserialization; includes child startup/imports, service, IPC and scheduling."
      },
      "analysis_startup_transport_overhead_ms": {
        "unit": "ms",
        "definition": "Dispatch-to-receive minus child service total: combined startup/imports, shared-memory attachment, IPC/serialization and scheduling; these components are NOT independently separated. Unavailable for a missing service duration or negative duration difference, never clamped to zero."
      }
    }
  },
